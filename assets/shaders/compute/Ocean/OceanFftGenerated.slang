// Mitsuyasu normalization Q(s) -- fit in ln(s)/ln(Q) space
// valid range: s in [0.0001, 125607], clamped to it
// max relative error: low segment 6.98e-04, high segment 5.26e-04
internal float MitsuyasuNormalizationFactor(in float s)
{
    static const float MitsuyasuSplitS = 0.514009146f;
    const float lnS = log(clamp(s, 0.0001f, 125607.351f));
    if (s <= MitsuyasuSplitS)
    {
        return exp(mad(mad(mad(mad(mad(mad(mad(-1.68814748e-06f, lnS, -6.14372277e-05f), lnS, -0.000873083148f), lnS, -0.00572268355f), lnS, -0.0115015087f), lnS, 0.0638669315f), lnS, 0.410357153f), lnS, -1.13463315f));
    }
    else
    {
        return exp(mad(mad(mad(mad(mad(mad(mad(-1.46719636e-07f, lnS, 7.32592447e-06f), lnS, -0.000153132375f), lnS, 0.00174416823f), lnS, -0.0117979112f), lnS, 0.0481886756f), lnS, 0.387106913f), lnS, -1.14479795f));
    }
}

// Hasselman normalization Q(s) -- fit in ln(s)/ln(Q) space
// valid range: s in [0.0001, 14490], clamped to it
// max relative error: low segment 6.99e-04, high segment 6.65e-04
internal float HasselmanNormalizationFactor(in float s)
{
    static const float HasselmanSplitS = 0.51580555f;
    const float lnS = log(clamp(s, 0.0001f, 14490.0f));
    if (s <= HasselmanSplitS)
    {
        return exp(mad(mad(mad(mad(mad(mad(mad(-1.69266541e-06f, lnS, -6.16023896e-05f), lnS, -0.000875547335f), lnS, -0.00574196483f), lnS, -0.0115860203f), lnS, 0.0636623262f), lnS, 0.410108245f), lnS, -1.13474806f));
    }
    else
    {
        return exp(mad(mad(mad(mad(mad(mad(mad(-1.74048542e-07f, lnS, 8.27067143e-06f), lnS, -0.000165646456f), lnS, 0.00182319309f), lnS, -0.0120355728f), lnS, 0.0484671892f), lnS, 0.387090043f), lnS, -1.14486022f));
    }
}

// Donelan-Banner normalization Q(beta, s) from the LUT: x = beta (linear), y = swell s (square root mapped)
internal float SampleDonelanBannerLUT(in float beta, in float swell)
{
    const float u = saturate((beta - 0.0531253144f) / 2.33297291f);
    const float v = sqrt(saturate((swell - 0.0f) / 14490.0f));
    return normTexture.SampleLevel(normSampler, float2(u, v), 0.0f).r;
}

